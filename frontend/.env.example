# Frontend Environment Configuration
# Copy this file to .env.local and fill in your deployed contract addresses

# Smart Contract Addresses (get these from deployments.json after deployment)
VITE_BOND_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VITE_PROJECT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MILESTONE_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
VITE_GOVERNANCE_DAO_ADDRESS=0x0000000000000000000000000000000000000000
VITE_REPAYMENT_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
VITE_REVENUE_ENGINE_ADDRESS=0x0000000000000000000000000000000000000000
VITE_INSURANCE_POOL_ADDRESS=0x0000000000000000000000000000000000000000

# Network Configuration
VITE_CREDITCOIN_RPC=https://testnet-rpc.creditcoin.network/rpc
VITE_CHAIN_ID=12391
VITE_NETWORK_NAME=Creditcoin Testnet

# IPFS Configuration
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud
VITE_IPFS_API=https://api.pinata.cloud

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api

# Feature Flags
VITE_ENABLE_INSURANCE=true
VITE_ENABLE_DAO_VOTING=true
VITE_ENABLE_REPAYMENTS=true
